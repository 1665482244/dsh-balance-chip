{
  "name": "@dsh-external/dsh-client-ui-balance-chip",
  "description": "Composer account-balance chip for DSH Web: shows the DeepSeek account balance right of the permission switch, refreshes it live, and alerts when it drops below a user-set threshold.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1665482244/dsh-balance-chip.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "alert"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": ">=18"
  }
}
